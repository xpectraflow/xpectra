# ==============================================================================
# XpectraFlow Self-Hosting Configuration Environment File
# ==============================================================================
# Copy this file to '.env' before booting:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Ports Configuration
# ------------------------------------------------------------------------------
PORT=3000
GRPC_PORT=50051
INGEST_PORT=50052

# ------------------------------------------------------------------------------
# NextAuth Authentication Config
# ------------------------------------------------------------------------------
# Run `openssl rand -base64 32` to generate a secure secret
NEXTAUTH_SECRET=changeme_some_ultra_secure_long_secret_phrase
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Internal Services Configurations
# ------------------------------------------------------------------------------
# TimescaleDB Settings
POSTGRES_DB=xpectradb
POSTGRES_USER=xpectra_admin
POSTGRES_PASSWORD=choose_a_strong_database_password_here

# Redis Authentication Settings
REDIS_AUTH=choose_a_strong_redis_password_here

# MinIO Object Storage Settings
MINIO_ROOT_USER=xpectra_minio_admin
MINIO_ROOT_PASSWORD=choose_a_strong_minio_password_here

# ------------------------------------------------------------------------------
# Automatic Root Bootstrapping (Admin Account Provisioning)
# ------------------------------------------------------------------------------
# If configured, XpectraFlow will automatically create the root admin user,
# the default organization, and set up your initial project workspace on startup!
XPECTRA_INIT_USER_NAME="System Administrator"
XPECTRA_INIT_USER_EMAIL=admin@xpectraflow.com
XPECTRA_INIT_USER_PASSWORD=Admin@12345
XPECTRA_INIT_ORG_NAME="Xpectra Systems"
